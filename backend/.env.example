# # ==========================
# # SERVER
# # ==========================
# NODE_ENV=development
# PORT=5000
# CLIENT_URL=http://localhost:5173

# # ==========================
# # DATABASE (MySQL)
# # ==========================
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=attendance_system
# DB_USER=root
# DB_PASSWORD=change_me
# DB_DIALECT=mysql

# # ==========================
# # JWT
# # ==========================
# JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# JWT_REFRESH_EXPIRES_IN=7d

# # Cookie settings
# COOKIE_SECURE=false
# COOKIE_DOMAIN=localhost

# # ==========================
# # PASSWORD RESET
# # ==========================
# RESET_TOKEN_EXPIRES_MIN=30

# # ==========================
# # QR ATTENDANCE
# # ==========================
# # Minutes after which an employee's QR secure token rotates/expires
# QR_TOKEN_ROTATE_MINUTES=1440
# # HMAC secret used to sign the random token embedded in the QR image
# QR_SECRET=replace_with_another_long_random_secret

# # ==========================
# # ATTENDANCE RULES
# # ==========================
# OFFICE_START_TIME=09:30
# LATE_MARK_GRACE_MINUTES=15
# HALF_DAY_MIN_HOURS=4
# FULL_DAY_MIN_HOURS=8

# # ==========================
# # RATE LIMITING
# # ==========================
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_MAX=100
# LOGIN_RATE_LIMIT_MAX=10

# # ==========================
# # SUPER ADMIN SEED
# # ==========================
# SUPER_ADMIN_EMAIL=superadmin@company.com
# SUPER_ADMIN_PASSWORD=ChangeMe@123
